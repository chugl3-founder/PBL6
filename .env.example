# ==============================================================================
# BIẾN MÔI TRƯỜNG MẪU (ENVIRONMENT VARIABLES)
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_DB=badminton_db
POSTGRES_USER=badminton_user
POSTGRES_PASSWORD=badminton_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/badminton_db

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Supabase S3-compatible Object Storage (or local MinIO)
S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
S3_PUBLIC_URL=https://your-project.supabase.co/storage/v1/object/public
S3_ACCESS_KEY=your-supabase-s3-access-key
S3_SECRET_KEY=your-supabase-s3-secret-key
S3_REGION=ap-southeast-1
S3_PATH_STYLE_ACCESS=true
S3_BUCKET_VIDEOS=badminton-videos
S3_BUCKET_AVATARS=badminton-avatars

# JWT Secret (Base64 or 256-bit Key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=1800000

# Frontend Environment
VITE_API_URL=http://localhost:8080

