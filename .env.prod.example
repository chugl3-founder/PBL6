# Production settings for docker-compose.prod.yml. Copy to .env.prod on the server and fill in.
# .env.prod holds passwords: never commit it.

# ":80" = plain HTTP on the server IP. With a domain pointing at the server, put the domain here
# (for example badminton.example.com) and Caddy turns on HTTPS by itself.
SITE_ADDRESS=:80

# --- Backend (Spring Boot) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

SPRING_RABBITMQ_HOST=
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=
SPRING_RABBITMQ_PASSWORD=
SPRING_RABBITMQ_VIRTUAL_HOST=

S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
S3_PUBLIC_URL=https://your-project.supabase.co/storage/v1/object/public
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-southeast-1
S3_PATH_STYLE_ACCESS=true
S3_BUCKET_VIDEOS=badminton-videos
S3_BUCKET_AVATARS=badminton-avatars

JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_MS=604800000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

GEMINI_API_KEY=

# --- Media worker (same broker, database and storage, in the form the Python worker reads) ---
AMQP_URL=amqp://user:password@host:5672/vhost
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASS=
S3_BUCKET=badminton-videos
